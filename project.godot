; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be also edited using any text editor.

config_version=5

[application]

config/name="Tower Defense: Last Grid"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/managers/event_bus.gd"
GameState="*res://scripts/managers/game_state.gd"
Settings="*res://scripts/managers/settings.gd"
SaveSystem="*res://scripts/managers/save_system.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"
SceneManager="*res://scripts/managers/scene_manager.gd"
Localization="*res://scripts/managers/localization.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

